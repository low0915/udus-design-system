  "components": [
    {
      "name": "Logo",
      "group": "Brand",
      "summary": "The SuDu AI logo."
    },
    {
      "name": "LogoIcon",
      "group": "Brand",
      "summary": "The alien head alone, cut from the primary logo — for favicons, avatars, the collapsed rail, watermarks and any square or space-constrained slot."
    },
    {
      "name": "BrandMark",
      "group": "Brand",
      "summary": "A secondary geometric mark family — not the logo."
    },
    {
      "name": "Icon",
      "group": "Core",
      "summary": "Renders one Material Symbols Outlined glyph — use it anywhere SuDu AI shows an icon; never hand-roll an SVG."
    },
    {
      "name": "Button",
      "group": "Core",
      "summary": "The standard SuDu AI button; primary is the single neon accent on a view, everything else is secondary or ghost."
    },
    {
      "name": "IconButton",
      "group": "Core",
      "summary": "Glyph-only control for utility actions where a label would add noise."
    },
    {
      "name": "Chip",
      "group": "Status",
      "summary": "Capability switcher chip — the row above the prompt textarea."
    },
    {
      "name": "Badge",
      "group": "Status",
      "summary": "Non-interactive metadata badge; use Chip when it is clickable."
    },
    {
      "name": "StatusPill",
      "group": "Status",
      "summary": "Signals live system state — agent mode, engine health, anomaly alerts."
    },
    {
      "name": "Input",
      "group": "Forms",
      "summary": "Single-line field for settings, search and naming."
    },
    {
      "name": "Checkbox",
      "group": "Forms",
      "summary": "Multi-select control for agent permissions, connector scopes and export options."
    },
    {
      "name": "Radio",
      "group": "Forms",
      "summary": "Single-choice control — reasoning mode, model tier, sandbox class."
    },
    {
      "name": "PromptConsole",
      "group": "Forms",
      "summary": "The product's primary input surface — one per workspace view, docked to the bottom over a protection gradient."
    },
    {
      "name": "Card",
      "group": "Surfaces",
      "summary": "The workspace's structural module — diagnostic artifacts, connector rows, metric panels."
    },
    {
      "name": "Disclosure",
      "group": "Surfaces",
      "summary": "Wraps the agent's visible reasoning so users can audit each stage."
    },
    {
      "name": "CodeBlock",
      "group": "Surfaces",
      "summary": "Shows generated scripts and tool output inside an agent message."
    },
    {
      "name": "NavItem",
      "group": "Navigation",
      "summary": "Sidebar destination row."
    },
    {
      "name": "Breadcrumb",
      "group": "Navigation",
      "summary": "Locates the user inside a workspace → swarm → stream hierarchy."
    },
    {
      "name": "TabBar",
      "group": "Navigation",
      "summary": "Switches the inspector between tool, memory and parameter views."
    },
    {
      "name": "MetricCapsule",
      "group": "Data",
      "summary": "Surfaces one operational number in a header or toolbar."
    },
    {
      "name": "ProgressRing",
      "group": "Data",
      "summary": "Shows how full a bounded resource is."
    },
    {
      "name": "Sparkline",
      "group": "Data",
      "summary": "The product's only chart form — a neon line over an 8%-opacity area fill."
    },
    {
      "name": "UserMessage",
      "group": "AI",
      "summary": "The human turn in a chat stream."
    },
    {
      "name": "AgentMessage",
      "group": "AI",
      "summary": "The agent turn."
    },
    {
      "name": "ReasoningStep",
      "group": "AI",
      "summary": "One line of the agent's audit trail: what it did, and to what."
    },
    {
      "name": "ConnectorRow",
      "group": "AI",
      "summary": "Lists what the agent is actually wired into — the trust surface of the product."
    },
    {
      "name": "Workspace",
      "group": "Workspace",
      "summary": "Showcase page: a click-through recreation of the SuDu AI agent workspace, composed entirely from this system's components — use it as the reference for how the…",
      "page": true
    }
